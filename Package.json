{
    "name": "rudapi",
    "version": "1.0.0",
    "description": "RudAPI - a personal backbone API for future projects",
    "main": "src/index.js",
    "scripts": {
        "dev": "nodemon src/index.js",
        "start": "node src/index.js",
        "db:create": "sequelize db:create",
